{
  "manifest_version": 3,
  "name": "Deer Guard - 小鹿網路安全插件",
  "version": "1.0.0",
  "description": "即時偵測可疑網站，保護您免受釣魚詐騙。隱私優先，所有判斷在本地完成。",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://rdap.verisign.com/*",
    "https://tld-rdap.verisign.com/*",
    "https://rdap.publicinterestregistry.org/*",
    "https://rdap.centralnic.com/*",
    "https://rdap.identitydigital.services/*",
    "https://rdap.zdnsgtld.com/*",
    "https://rdap.gmoregistry.net/*",
    "https://rdap.nic.club/*",
    "https://rdap.nic.buzz/*",
    "https://rdap.tucowsregistry.net/*",
    "https://rdap.nic.work/*",
    "https://rdap.registry.cloud/*",
    "https://rdap.nic.bid/*",
    "https://rdap.nic.win/*",
    "https://rdap.nic.loan/*",
    "https://ccrdap.twnic.tw/*",
    "https://rdap.nominet.uk/*",
    "https://rdap.nic.fr/*",
    "https://rdap.sidn.nl/*",
    "https://rdap.cctld.au/*",
    "https://rdap.ca.fury.ca/*",
    "https://rdap.registro.br/*",
    "https://rdap.sgnic.sg/*",
    "https://rdap.norid.no/*",
    "https://rdap.fi/*",
    "https://rdap.dns.pl/*",
    "https://rdap.nic.cz/*",
    "https://rdap.nic.ar/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
